#
# -----------------------------------------------------
# Modular zshrc loader approach
# -----------------------------------------------------
#
# Shared modules live in ~/.config/zshrc.
# Machine-specific overrides live in ~/.config/zshrc/custom.
# If a matching file exists in custom/, it is sourced instead
# of the shared module.
# -----------------------------------------------------

for f in "$HOME"/.config/zshrc/*; do
  [ -f "$f" ] || continue
  base="${f##*/}"
  custom="$HOME/.config/zshrc/custom/$base"
  if [ -f "$custom" ]; then
    source "$custom"
  else
    source "$f"
  fi
done

if [ -f "$HOME/.zshrc_custom" ]; then
  source "$HOME/.zshrc_custom"
fi
